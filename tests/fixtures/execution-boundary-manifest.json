{
  "schema_version": "tool_manifest/v1",
  "manifest_id": "test-execution-boundary",
  "display_name": "EWB internal execution boundary",
  "stability": "experimental",
  "enabled_by_default": true,
  "adapter": { "id": "ewb-test-execution-boundary", "version": "1" },
  "identity_contract": {
    "executable_candidates": ["ewb-test-native"],
    "version_probe": { "arguments": ["--version"] },
    "binary_digest_required": true,
    "allowed_binary_sha256": ["__EWB_TEST_NATIVE_SHA256__"],
    "python_distribution": null,
    "supporting_tree_digest_required": false
  },
  "subject_kind": "git",
  "invocation_contract": {
    "mode": "direct_exec",
    "operation": "repopass_local_inspect",
    "parameters": [],
    "required_capabilities": ["read_subject"],
    "target_code_execution": "none",
    "network": "denied_by_arguments",
    "filesystem_write": "none_expected"
  },
  "artifact_contracts": [
    { "role": "native_stdout", "discovery": "captured_stream", "required_when": "spawned", "byte_policy": "exact" },
    { "role": "native_stderr", "discovery": "captured_stream", "required_when": "spawned", "byte_policy": "exact" }
  ],
  "native_observation_contracts": [
    { "namespace": "ewb_test_fixture", "name": "native_status", "artifact_role": "native_stdout", "format": "json", "selector": "/status", "required_when": "process_exited", "unknown_value_policy": "preserve_unrecognized" }
  ],
  "exit_code_contract": {
    "entries": [
      { "code": 0, "native_meaning": "fixture_completed_not_verdict_pass" },
      { "code": 1, "native_meaning": "fixture_native_block" }
    ],
    "unknown_code_policy": "preserve_unrecognized"
  },
  "authority_contract": { "mode": "not_reported" },
  "limitations": [
    { "code": "test_fixture_only", "statement": "This adapter exists only in the package-excluded integration harness and carries no production tool authority." },
    { "code": "direct_process_not_os_sandbox", "statement": "Capability approval constrains this test invocation; it is not an operating-system sandbox." }
  ]
}
