{
  "schema_version": "tool_manifest/v1",
  "manifest_id": "stateweaver-foundation",
  "display_name": "StateWeaver fixed synthetic foundation",
  "stability": "experimental",
  "enabled_by_default": false,
  "adapter": { "id": "stateweaver-foundation-verify", "version": "1" },
  "identity_contract": {
    "executable_candidates": ["stateweaver"],
    "version_probe": { "arguments": ["--json", "doctor"] },
    "binary_digest_required": true,
    "python_distribution": "stateweaver",
    "supporting_tree_digest_required": true
  },
  "subject_kind": "self_foundation",
  "invocation_contract": {
    "mode": "direct_exec",
    "operation": "stateweaver_foundation_verify",
    "parameters": [],
    "required_capabilities": ["execute_fixed_synthetic"],
    "target_code_execution": "fixed_synthetic_only",
    "network": "none",
    "filesystem_write": "native_defined"
  },
  "artifact_contracts": [
    { "role": "native_stdout", "discovery": "captured_stream", "required_when": "spawned", "byte_policy": "exact" },
    { "role": "native_stderr", "discovery": "captured_stream", "required_when": "spawned", "byte_policy": "exact" }
  ],
  "native_observation_contracts": [
    { "namespace": "stateweaver", "name": "accepted", "artifact_role": "native_stdout", "format": "json", "selector": "/accepted", "required_when": "process_exited", "unknown_value_policy": "preserve_unrecognized" }
  ],
  "exit_code_contract": {
    "entries": [
      { "code": 0, "native_meaning": "native_acceptance" },
      { "code": 1, "native_meaning": "native_rejection" },
      { "code": 2, "native_meaning": "native_usage_or_contract_error" }
    ],
    "unknown_code_policy": "preserve_unrecognized"
  },
  "authority_contract": { "mode": "not_reported" },
  "limitations": [
    { "code": "fixed_synthetic_only", "statement": "This adapter verifies StateWeaver's fixed synthetic foundation and cannot verify an arbitrary repository." },
    { "code": "frozen_candidate_separate_from_execution", "statement": "StateWeaver candidate commit 598753d182dda65c73a313e9efbf20b826942f0a is admitted by a separate candidate_pin/v1 record; that record is not a native execution identity." },
    { "code": "candidate_not_execution_capsule", "statement": "The admitted candidate targets Linux x86_64 CPython 3.13, contains wheels but no interpreter, and cannot satisfy the current Windows EWB runtime snapshot contract." },
    { "code": "external_qualification_pending", "statement": "The native candidate reports CANDIDATE_READY_FOR_EXTERNAL_QUALIFICATION and release_eligible=false; M2 clean-host and M6-M8 external qualification remain outside this adapter." },
    { "code": "acceptance_not_authority", "statement": "The accepted field is preserved as a native observation and is not promoted into workbench authority." },
    { "code": "direct_process_not_os_sandbox", "statement": "Capability approval constrains this adapter invocation; it is not an operating-system sandbox." }
  ]
}
