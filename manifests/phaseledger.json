{
  "schema_version": "tool_manifest/v1",
  "manifest_id": "phaseledger",
  "display_name": "phaseledger strict measure",
  "stability": "experimental",
  "enabled_by_default": false,
  "adapter": { "id": "phaseledger-strict-measure", "version": "1" },
  "identity_contract": {
    "executable_candidates": ["phaseledger"],
    "version_probe": null,
    "binary_digest_required": true,
    "python_distribution": "phaseledger",
    "supporting_tree_digest_required": true
  },
  "subject_kind": "artifact",
  "invocation_contract": {
    "mode": "direct_exec",
    "operation": "phaseledger_measure",
    "parameters": [],
    "required_capabilities": ["read_artifact"],
    "target_code_execution": "none",
    "network": "none_expected",
    "filesystem_write": "none_by_adapter"
  },
  "artifact_contracts": [
    { "role": "native_stdout", "discovery": "captured_stream", "required_when": "spawned", "byte_policy": "exact" },
    { "role": "native_stderr", "discovery": "captured_stream", "required_when": "spawned", "byte_policy": "exact" }
  ],
  "native_observation_contracts": [
    { "namespace": "phaseledger", "name": "verdict", "artifact_role": "native_stdout", "format": "text_prefix", "selector": "VERDICT:", "required_when": "process_exited", "unknown_value_policy": "preserve_unrecognized" }
  ],
  "exit_code_contract": {
    "entries": [
      { "code": 0, "native_meaning": "PASS" },
      { "code": 1, "native_meaning": "FAIL" },
      { "code": 3, "native_meaning": "UNKNOWN" },
      { "code": 4, "native_meaning": "INCOMPLETE" }
    ],
    "unknown_code_policy": "preserve_unrecognized"
  },
  "authority_contract": { "mode": "not_reported" },
  "limitations": [
    { "code": "python_execution_containment_missing", "statement": "Exact-byte capsule admission is implemented, but EWB does not yet provide OS-enforced no-network and child-process containment for Python execution." },
    { "code": "caller_observation_gate", "statement": "phaseledger checks caller-supplied observations; it does not execute or independently verify those checks." },
    { "code": "native_version_not_reported", "statement": "The current native CLI has no version command; the executable bytes are still pinned." },
    { "code": "direct_process_not_os_sandbox", "statement": "Capability approval constrains this adapter invocation; it is not an operating-system sandbox." }
  ]
}
