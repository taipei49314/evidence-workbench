{
  "schema_version": "tool_manifest/v1",
  "manifest_id": "repopass-inspect",
  "display_name": "RepoPassport local inspect",
  "stability": "experimental",
  "enabled_by_default": false,
  "adapter": { "id": "repopass-local-inspect", "version": "1" },
  "identity_contract": {
    "executable_candidates": ["repopass"],
    "version_probe": { "arguments": ["--output", "json", "--version"] },
    "binary_digest_required": true,
    "python_distribution": null,
    "supporting_tree_digest_required": false
  },
  "subject_kind": "git",
  "invocation_contract": {
    "mode": "direct_exec",
    "operation": "repopass_local_inspect",
    "parameters": [],
    "required_capabilities": ["read_subject"],
    "target_code_execution": "none",
    "network": "denied_by_arguments",
    "filesystem_write": "none_expected"
  },
  "artifact_contracts": [
    { "role": "native_stdout", "discovery": "captured_stream", "required_when": "spawned", "byte_policy": "exact" },
    { "role": "native_stderr", "discovery": "captured_stream", "required_when": "spawned", "byte_policy": "exact" }
  ],
  "native_observation_contracts": [
    { "namespace": "repopass", "name": "cli_status", "artifact_role": "native_stdout", "format": "json", "selector": "/status", "required_when": "process_exited", "unknown_value_policy": "preserve_unrecognized" }
  ],
  "exit_code_contract": {
    "entries": [
      { "code": 0, "native_meaning": "command_completed_not_verdict_pass" }
    ],
    "unknown_code_policy": "preserve_unrecognized"
  },
  "authority_contract": { "mode": "not_reported" },
  "limitations": [
    { "code": "delivery_not_admitted", "statement": "The exact current source qualification reports BLOCKED and no self-contained Windows executable is published; planning remains disabled." },
    { "code": "local_git_dependency_not_bound", "statement": "Inspect may invoke Git from PATH when repository metadata is present; a future executable admission must bind or remove that subprocess dependency." },
    { "code": "inspect_not_verification", "statement": "Inspect does not establish a RepoPassport verification verdict." },
    { "code": "exit_zero_not_pass", "statement": "A RepoPassport process exit code of zero is not translated into a shared PASS." },
    { "code": "direct_process_not_os_sandbox", "statement": "Capability approval constrains this adapter invocation; it is not an operating-system sandbox." }
  ]
}
