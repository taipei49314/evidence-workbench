{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Workbench exact-byte artifact descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "roles", "media_type", "byte_length", "digest", "storage", "origin", "capture", "transforms"],
  "properties": {
    "artifact_id": { "type": "string", "pattern": "^artifact_[0-9a-f]{32}$" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" }
    },
    "media_type": { "type": "string", "minLength": 1 },
    "byte_length": { "type": "integer", "minimum": 0 },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": { "uri": { "type": "string", "pattern": "^ewb:sha256:[0-9a-f]{64}$" } }
    },
    "origin": { "enum": ["native_file", "process_stdout", "process_stderr"] },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "enum": ["byte_for_byte_copy", "raw_stream_capture"] } }
    },
    "transforms": { "type": "array", "maxItems": 0 }
  },
  "allOf": [
    {
      "if": { "properties": { "origin": { "const": "native_file" } }, "required": ["origin"] },
      "then": { "properties": { "capture": { "properties": { "mode": { "const": "byte_for_byte_copy" } } } } }
    },
    {
      "if": { "properties": { "origin": { "enum": ["process_stdout", "process_stderr"] } }, "required": ["origin"] },
      "then": { "properties": { "capture": { "properties": { "mode": { "const": "raw_stream_capture" } } } } }
    }
  ]
}
