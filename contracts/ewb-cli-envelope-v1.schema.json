{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Workbench CLI envelope v1",
  "description": "Logical contract ewb-cli-envelope/v1. The version is selected out of band so the established CLI JSON bytes do not acquire another top-level field.",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "command", "data"],
      "properties": {
        "ok": { "const": true },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$"
        },
        "data": {}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error"],
      "properties": {
        "ok": { "const": false },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
