{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Workbench Phaseledger caller observation cite v1",
  "description": "Caller-authored cite rules for a Phaseledger 0.6.0 observation file. This is not a Phaseledger native schema and is not written by EWB. Freshness and producer-run scope are unsupported. Trust Meter booleans and scores must not appear as check names or claim authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "phase", "claim", "artifact_present", "artifact_sha256",
    "cited_artifact", "checks", "unsupported", "authority_effect"
  ],
  "properties": {
    "schema_version": { "const": "phaseledger-caller-observation/v1" },
    "phase": { "type": "string", "minLength": 1, "maxLength": 128 },
    "claim": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "artifact_present": { "const": true },
    "artifact_sha256": { "$ref": "#/$defs/sha256" },
    "cited_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "digest", "byte_length"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^artifact_[0-9a-f]{32}$" },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "value": { "$ref": "#/$defs/sha256" }
          }
        },
        "byte_length": { "type": "integer", "minimum": 1 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "passed": { "type": "boolean" }
        }
      }
    },
    "unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freshness", "producer_run_scope"],
      "properties": {
        "freshness": { "const": "unsupported" },
        "producer_run_scope": { "const": "unsupported" }
      }
    },
    "authority_effect": { "const": "none" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
