{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Workbench upstream delivery pin v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_manifest_id", "repository_url", "source", "software_version", "release", "evidence", "runtime", "native_posture", "execution_readiness", "admission", "license_spdx"],
  "properties": {
    "schema_version": { "const": "upstream_pin/v1" },
    "tool_manifest_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
    "repository_url": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "source": { "$ref": "#/$defs/source" },
    "software_version": { "type": "string", "minLength": 1 },
    "release": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/release" }] },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
    "runtime": { "$ref": "#/$defs/runtime" },
    "native_posture": {
      "type": "object", "additionalProperties": false, "required": ["status", "release_eligible"],
      "properties": {
        "status": { "enum": ["ALPHA_SOURCE_VERIFIED", "CANDIDATE_ONLY_NOT_RELEASE_AUTHORIZED", "CANDIDATE_READY_FOR_EXTERNAL_QUALIFICATION", "CURRENT_SOURCE_VERIFIED_RELEASE_BLOCKED", "RELEASED_ALPHA_NON_CERTIFYING", "SOURCE_QUALIFICATION_BLOCKED", "SOURCE_VERIFIED", "SOURCE_VERIFIED_ADVISORY_MEASURE", "SOURCE_VERIFIED_AUTHORIZATION_REQUIRED"] },
        "release_eligible": { "type": ["boolean", "null"] }
      }
    },
    "execution_readiness": {
      "type": "object", "additionalProperties": false, "required": ["state", "scope", "blocker_codes"],
      "properties": {
        "state": { "enum": ["ready", "fail_closed"] },
        "scope": { "type": "string", "minLength": 1 },
        "blocker_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" } }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "ready" } } }, "then": { "properties": { "blocker_codes": { "maxItems": 0 } } } },
        { "if": { "properties": { "state": { "const": "fail_closed" } } }, "then": { "properties": { "blocker_codes": { "minItems": 1 } } } }
      ]
    },
    "admission": {
      "type": "object", "additionalProperties": false, "required": ["evidence_integrity_state", "authority_effect"],
      "properties": {
        "evidence_integrity_state": { "enum": ["source_verified", "published_checksums_verified", "verified_at_admission", "upstream_reported"] },
        "authority_effect": { "const": "none" }
      }
    },
    "license_spdx": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decimalId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["default_branch", "commit_sha", "tree_sha"],
      "properties": { "default_branch": { "type": "string", "minLength": 1 }, "commit_sha": { "$ref": "#/$defs/gitSha" }, "tree_sha": { "$ref": "#/$defs/gitSha" } }
    },
    "release": {
      "type": "object", "additionalProperties": false, "required": ["channel", "version", "tag", "release_id", "subject_commit_sha", "subject_tree_sha"],
      "properties": {
        "channel": { "enum": ["tag", "github_release", "candidate_release"] },
        "version": { "type": "string", "minLength": 1 }, "tag": { "type": "string", "minLength": 1 },
        "release_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/decimalId" }] },
        "subject_commit_sha": { "$ref": "#/$defs/gitSha" }, "subject_tree_sha": { "$ref": "#/$defs/gitSha" }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "name", "subject_commit_sha", "sha256", "size_bytes", "status", "expires_at"],
      "properties": {
        "kind": { "enum": ["workflow_run", "actions_artifact", "release_asset", "native_executable", "source_release"] },
        "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 },
        "subject_commit_sha": { "$ref": "#/$defs/gitSha" },
        "sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "size_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "status": { "enum": ["success", "failure", "blocked", "published", "verified_at_admission"] },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["kind", "target_os", "target_arch", "version_constraint", "interpreter_included", "transitive_dependencies_included", "self_contained", "external_tools"],
      "properties": {
        "kind": { "enum": ["native", "python"] }, "target_os": { "enum": ["any", "linux", "windows"] }, "target_arch": { "enum": ["any", "x86_64"] },
        "version_constraint": { "type": ["string", "null"] }, "interpreter_included": { "type": "boolean" },
        "transitive_dependencies_included": { "type": "boolean" }, "self_contained": { "type": "boolean" },
        "external_tools": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
