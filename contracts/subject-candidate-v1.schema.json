{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Workbench untrusted GitHub subject candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "producer",
    "repository_url",
    "resolved_source",
    "observed_at",
    "source_artifact",
    "limitations",
    "trust_state",
    "admission_requirement",
    "authority_effect"
  ],
  "properties": {
    "schema_version": { "const": "subject-candidate/v1" },
    "candidate_id": { "type": "string", "pattern": "^candidate_[0-9a-f]{32}$" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "github-radar" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "repository_url": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "resolved_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "tree_sha"],
      "properties": {
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "source_artifact": { "$ref": "#/$defs/artifact_ref" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/limitation" }
    },
    "trust_state": { "const": "untrusted_candidate" },
    "admission_requirement": { "const": "ewb_reresolve_commit_and_tree" },
    "authority_effect": { "const": "none" }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "digest"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^artifact_[0-9a-f]{32}$" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "statement"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
        },
        "statement": { "type": "string", "minLength": 1 }
      }
    }
  }
}
